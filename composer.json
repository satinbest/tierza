{
    "name": "tierza/tierza",
    "version": "0.1.0-dev",
    "description": "B2B pricing plugin for WooCommerce, targeting Iranian businesses.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Tierza Core Team",
            "email": "dev@tierza.org"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0",
        "phpstan/phpstan": "^1.12 || ^2.0"
    },
    "autoload": {
        "psr-4": {
            "Tierza\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tierza\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "phpstan": "phpstan analyse",
        "build:zip": "php bin/build-zip.php"
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true,
        "allow-plugins": {}
    }
}
