{
    "name": "tierza/tierza",
    "version": "0.1.0-dev",
    "description": "B2B pricing plugin for WooCommerce, targeting Iranian businesses.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Tierza Core Team",
            "email": "dev@tierza.org"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": ">=8.1"
    },
    "suggest": {
        "ext-bcmath": "Accelerates arbitrary-precision decimal arithmetic (deterministic pure-PHP fallback is included)"
    },
    "require-dev": {
        "dealerdirect/phpcodesniffer-composer-installer": "*",
        "phpstan/phpstan": "^1.12 || ^2.0",
        "phpunit/phpunit": "^10.5",
        "squizlabs/php_codesniffer": "^3.11",
        "wp-coding-standards/wpcs": "*"
    },
    "autoload": {
        "psr-4": {
            "Tierza\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tierza\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "phpstan": "phpstan analyse",
        "phpcs": "phpcs",
        "phpcbf": "phpcbf",
        "build:zip": "php bin/build-zip.php"
    },
    "config": {
        "platform": {
            "php": "8.1.0"
        },
        "sort-packages": true,
        "optimize-autoloader": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
